/* style/home_interface.qss — dark */

QFrame#homeInterface {
    background-color: transparent;
    border: none;
}

/* 左侧占位栏 */
QFrame#homeLeftColumn {
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
}

/* 右侧列容器本身透明，无边框 */
QWidget#homeRightColumn {
    background-color: transparent;
    border: none;
}

/* ScrollArea 及其内部 QWidget 视口全部透明 */
QScrollArea#homeRightScrollArea,
QScrollArea#homeRightScrollArea > QWidget {
    background: transparent;
    border: none;
}

/* 滚动内容容器透明 */
QWidget#homeRightScrollContent {
    background: transparent;
}

#importEdgeTab {
    qproperty-panelColor: rgba(0, 0, 0, 0.1795);
}

#dashboardEdgeTab {
    qproperty-panelColor: rgba(0, 0, 0, 0.1795);
}

QWidget#edgeTabSeparator {
    background-color: rgba(255, 255, 255, 0.10);
    border: none;
}

QWidget#dashboardSeparator {
    background-color: rgba(255, 255, 255, 0.10);
    border: none;
}

BodyLabel#dashboardTitleLabel {
    color: --ThemeColorPrimary;
}

#dashboardCard {
    background-color: rgba(255, 255, 255, 0.06);
    border: none;
    border-radius: 8px;
}

#dashboardMetricValue,
#dashboardMetricName {
    color: --ThemeColorPrimary;
}
