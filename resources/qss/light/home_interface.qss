/* style/home_interface.qss — light */

QFrame#homeInterface {
    background-color: transparent;
    border: none;
}

/* 左侧占位栏 */
QFrame#homeLeftColumn {
    background-color: transparent;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
}

/* 右侧列容器本身透明，无边框 */
QWidget#homeLeftColumn {
    background-color: transparent;
    border: none;
}

/* ScrollArea 及其内部 QWidget 视口全部透明 */
QScrollArea#homeLeftScrollArea,
QScrollArea#cardNavigationScrollArea,
QScrollArea#homeLeftScrollArea > QWidget {
    background: transparent;
    border: none;
}

QWidget#cardNavigationContent,
QScrollArea#cardNavigationScrollArea {
    background: transparent;
    border: none;
}

QWidget#homeRightPlaceholderBody,
QWidget#sessionDetailPane {
    background-color: rgba(0, 0, 0, 0.024);
    border: none;
    border-radius: 8px;
}

QWidget#homePanelSeparator,
QWidget#sessionManagerSeparator {
    background-color: rgba(0, 0, 0, 0.08);
    border: none;
}

QWidget#sessionNavigationList,
QWidget#sessionDetailPlaceholder,
QWidget#homeRightPlaceholderText {
    background: transparent;
}

QWidget#sessionDetailContent,
QWidget#sessionDetailMetrics,
QFrame#sessionDetailCommandBar,
QWidget#sessionDetailInfoRow {
    background: transparent;
    border: none;
}

QWidget#sessionDetailInfoPanel {
    background-color: transparent;
    border: none;
}

QLabel#sessionDetailName {
    background: transparent;
    font-size: 16px;
    font-weight: 600;
}

QLabel#sessionDetailTime,
QLabel#sessionDetailInfoTitle {
    color: rgba(0, 0, 0, 0.60);
}

/* 滚动内容容器透明 */
QWidget#cardNavigationContent,
QWidget#homeLeftScrollContent {
    background: transparent;
}

#importEdgeTab {
    qproperty-panelColor: rgba(0, 0, 0, 0.024);
}

#dashboardEdgeTab {
    qproperty-panelColor: rgba(0, 0, 0, 0.024);
}

QWidget#edgeTabSeparator {
    background-color: rgba(0, 0, 0, 0.08);
    border: none;
}

QWidget#dashboardSeparator {
    background-color: rgba(0, 0, 0, 0.08);
    border: none;
}

#dashboardCard {
    background-color: rgba(255, 255, 255, 0.88);
    border: none;
    border-radius: 8px;
}

#dashboardSkeletonHero,
#dashboardSkeletonBar {
    background-color: rgba(0, 0, 0, 0.12);
    border: none;
}

#dashboardSkeletonHero {
    border-radius: 8px;
}

#dashboardSkeletonBar {
    border-radius: 8px;
}

#dashboardMetricValue {
    font-size: 16px;
    font-weight: bold;
}
