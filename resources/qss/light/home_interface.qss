/* style/home_interface.qss — light */

QFrame#homeInterface {
    background-color: transparent;
    border: none;
}

/* 左侧占位栏 */
QFrame#homeLeftColumn {
    background-color: transparent;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
}

/* 右侧列容器本身透明，无边框 */
QWidget#homeLeftColumn {
    background-color: transparent;
    border: none;
}

/* ScrollArea 及其内部 QWidget 视口全部透明 */
QScrollArea#homeLeftScrollArea,
QScrollArea#cardNavigationScrollArea,
QScrollArea#homeLeftScrollArea > QWidget {
    background: transparent;
    border: none;
}

QWidget#cardNavigationContent,
QScrollArea#cardNavigationScrollArea {
    background: transparent;
    border: none;
}

QWidget#homeRightPlaceholderBody,
QWidget#sessionDetailPane {
    background-color: rgba(0, 0, 0, 0.024);
    border: none;
    border-radius: 8px;
}

QWidget#homePanelSeparator,
QWidget#sessionManagerSeparator {
    background-color: rgba(0, 0, 0, 0.08);
    border: none;
}

QWidget#sessionNavigationList,
QWidget#sessionDetailPlaceholder,
QWidget#homeRightPlaceholderText {
    background: transparent;
}

QWidget#sessionDetailContent,
QWidget#sessionDetailMetrics,
QFrame#sessionDetailCommandBar,
QWidget#sessionDetailInfoRow {
    background: transparent;
    border: none;
}

QWidget#sessionDetailInfoPanel {
    background-color: transparent;
    border: none;
}

QLabel#sessionDetailName {
    background: transparent;
    font-size: 16px;
    font-weight: bold;
}

QLabel#sessionDetailTime,
QLabel#sessionDetailInfoTitle {
    color: rgba(0, 0, 0, 0.60);
}

/* 滚动内容容器透明 */
QWidget#cardNavigationContent,
QWidget#homeLeftScrollContent {
    background: transparent;
}

#importEdgeTab {
    qproperty-panelColor: rgba(0, 0, 0, 0.024);
}

#dashboardEdgeTab {
    qproperty-panelColor: rgba(0, 0, 0, 0.024);
}

#dataPoolEdgeTab {
    qproperty-panelColor: rgba(0, 0, 0, 0.024);
}

QWidget#dataPoolBody,
QWidget#dataPoolTabPage,
QWidget#dataPoolTabViewport,
QWidget#dataPoolTabContent,
QScrollArea#dataPoolTabScrollArea,
QScrollArea#dataPoolTabScrollArea > QWidget {
    background: transparent;
    border: none;
}

QWidget#dataPoolDetailMetrics,
QWidget#dataPoolDetailInfoPanel,
QWidget#dataPoolDetailInfoRow {
    background: transparent;
    border: none;
}

QLabel#dataPoolDetailTitle {
    background: transparent;
    font-size: 16px;
    font-weight: bold;
}

QLabel#dataPoolDetailInfoTitle {
    color: rgba(0, 0, 0, 0.60);
}

QWidget#edgeTabSeparator {
    background-color: rgba(0, 0, 0, 0.08);
    border: none;
}

QWidget#dashboardSeparator {
    background-color: rgba(0, 0, 0, 0.08);
    border: none;
}

#dashboardCard {
    background-color: rgba(255, 255, 255, 0.88);
    border: none;
    border-radius: 8px;
}

#dashboardSkeletonHero,
#dashboardSkeletonBar {
    background-color: rgba(0, 0, 0, 0.12);
    border: none;
}

#dashboardSkeletonHero {
    border-radius: 8px;
}

#dashboardSkeletonBar {
    border-radius: 8px;
}

#dashboardMetricValue {
    font-size: 16px;
    font-weight: bold;
}

/* 全速处理面板与 Session 管理详情区使用相同的透明滚动层和卡片层次。 */
QWidget#fullSpeedPanelSeparator {
    background-color: rgba(0, 0, 0, 0.08);
    border: none;
}

QScrollArea#homeFullSpeedScrollArea,
QScrollArea#homeFullSpeedScrollArea > QWidget,
QWidget#homeFullSpeedViewport,
QWidget#homeFullSpeedBody,
QWidget#homeFullSpeedContent,
QWidget#homeFullSpeedCards {
    background: transparent;
    border: none;
}

QWidget#homeFullSpeedSessionPane {
    background-color: rgba(0, 0, 0, 0.024);
    border: none;
    border-radius: 8px;
}

QFrame#fullSpeedSessionCard {
    background-color: rgba(255, 255, 255, 0.88);
    border: none;
    border-radius: 8px;
}

QLabel#fullSpeedPanelTitle,
QLabel#fullSpeedSessionTitle,
QLabel#fullSpeedSessionStatus,
QLabel#fullSpeedSessionCaption,
QLabel#fullSpeedSessionStage,
QLabel#homeFullSpeedEmptyLabel {
    background: transparent;
}

QLabel#fullSpeedSessionStatus,
QLabel#fullSpeedSessionCaption {
    color: rgba(0, 0, 0, 0.60);
}

QPushButton[fullSpeedSecondaryAction="true"] {
    background-color: transparent;
    border: none;
}

QPushButton[fullSpeedSecondaryAction="true"]:hover {
    background-color: rgba(0, 0, 0, 0.06);
}

QPushButton[fullSpeedSecondaryAction="true"]:pressed {
    background-color: rgba(0, 0, 0, 0.10);
}

QPushButton[fullSpeedSecondaryAction="true"]:disabled {
    background-color: transparent;
    color: rgba(0, 0, 0, 0.36);
}
